{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleSuffixes": [".web", ".native", ""],
    "noEmit": true,
    "strict": true,
    "target": "es2020",
    "types": ["react", "react-native"]
  },
  "extends": "expo/tsconfig.base"
}
